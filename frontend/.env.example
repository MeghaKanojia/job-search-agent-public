# Copy to .env for local dev if you need to override the default. Not needed in
# the Codespace -- Vite's dev-server proxy (see vite.config.ts) already forwards
# "/api" to the backend on localhost:8000, so this can stay unset there.
#
# Required in production (set as a Vercel project environment variable): the
# deployed backend's full URL, since Vercel and Render are separate domains with
# no proxy between them.
VITE_API_BASE_URL=https://your-backend.onrender.com/api
