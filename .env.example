# Copy to .env for local/Codespaces dev. In production these are GitHub Actions
# secrets (pipeline) and Render environment variables (backend) -- never commit
# real values.

DATABASE_URL=postgresql://user:password@host/dbname
ENCRYPTION_KEY=

# Backend-only (see backend/app/core/auth.py). Gates every API route except
# /health -- required in ALL environments, including local/Codespace dev
# (fails closed: unset means every request 500s, rather than accidentally
# deploying to Render with no protection). Any value works for local dev
# since the Codespace is already access-controlled via GitHub; use a real,
# unique password in production. Entered once per browser session via the
# dashboard's own login screen -- never put this in a VITE_-prefixed var,
# those get bundled into the public frontend JS.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Multi-provider LLM setup (see pipeline/llm/ and backend/app/services/llm/).
# Used for cover-letter drafting, status-email classification, and
# relevance-judgment scoring, grounded via RAG (pipeline/rag.py). Every call
# site falls back to existing rule-based logic if all providers are unset.
#
# Groq: ongoing free tier, no billing risk. Recommended default.
GROQ_API_KEY=
# Gemini: free tier exists but Google doesn't publish a fixed limits table.
# Enabling billing on the Google Cloud project removes the free tier
# entirely -- never do that if this should stay free.
GEMINI_API_KEY=
# Claude/Anthropic and Cerebras were evaluated and deliberately excluded --
# neither has an ongoing free tier, only a one-time trial credit, so they
# don't meet this project's free-only requirement.
# Which provider automated background jobs use by default (can be overridden
# per-request for on-demand actions like cover-letter drafting).
DEFAULT_LLM_PROVIDER=groq

# Manually-obtained saved-search URL for jobs.ie/irishjobs.ie -- see docs/SETUP.md
IRISH_BOARDS_SEARCH_URL=

SEARCH_TERMS=Data Engineer,Data Analyst,Data Scientist,AI Engineer,ML Engineer,Analytics Engineer
SEARCH_LOCATION=Ireland
